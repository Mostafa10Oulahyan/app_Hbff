{
  "expo": {
    "name": "hangoutbff",
    "slug": "hangoutbff",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hangoutbff",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyDf-ZLaE5_arIb2FmieKHje9TAdzoXvF1I"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to show hangouts near you."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDf-ZLaE5_arIb2FmieKHje9TAdzoXvF1I"
        }
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.m0hamed_uxxv.hangoutbff",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "We need your location to show hangouts near you."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-notifications",
      "expo-secure-store",
      "expo-web-browser",
      "expo-maps",
      [
        "expo-maps",
        {
          "requestLocationPermission": true,
          "locationPermission": "Allow hangoutbff to use your location"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "23de7363-c4e2-4e57-bd77-cbb4b1b63ac6"
      }
    },
    "owner": "mostafaoulahyans-team"
  }
}
